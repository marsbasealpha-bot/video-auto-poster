# ─── Folders ──────────────────────────────────────────────────────────────────
WATCH_FOLDER=C:\Users\Admin\Desktop\Uploads
PROCESSED_FOLDER=C:\Users\Admin\Desktop\Uploads\processed

# ─── FFmpeg ───────────────────────────────────────────────────────────────────
# Leave as "ffmpeg" if ffmpeg is on your system PATH, or provide full path
FFMPEG_PATH=ffmpeg

# ─── Platform Toggles ────────────────────────────────────────────────────────
ENABLE_YOUTUBE=true
ENABLE_TIKTOK=true
ENABLE_INSTAGRAM=true
ENABLE_X=true

# ─── Reservoir & Scheduling ────────────────────────────────────────────────
SCHEDULING_INTERVAL_HOURS=4
PRIORITY_POST_IMMEDIATE=true

# Stage Gates (Manual Approval)
# Set to 'true' to require approval, 'false' for full automation
CONFIRM_METADATA=true
CONFIRM_CAPTIONS=true
CONFIRM_FINAL=true

# ─── AI Automation (Gemini) ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── YouTube ─────────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json

# ─── TikTok ──────────────────────────────────────────────────────────────────
TIKTOK_SESSION_FILE=tiktok_session.json

# ─── Instagram ───────────────────────────────────────────────────────────────
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
INSTAGRAM_SESSION_FILE=instagram_session.json

# ─── X (Twitter) ─────────────────────────────────────────────────────────────
X_USERNAME=your_x_username
X_PASSWORD=your_x_password
X_SESSION_FILE=x_session.json

# ─── Default Post Metadata ────────────────────────────────────────────────────
DEFAULT_TITLE=Check this out!
DEFAULT_HASHTAGS=#viral #trending #fyp
DEFAULT_DESCRIPTION=
